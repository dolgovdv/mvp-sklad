datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Таблица пользователей для Google OAuth
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Таблица товаров для формы ввода на складе
model InventoryItem {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  quantity    Int      @default(0)
  price       Float    @default(0.0)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
